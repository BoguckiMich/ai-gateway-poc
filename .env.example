# Prawdziwy klucz Anthropic - tylko gateway go zna
ANTHROPIC_API_KEY=sk-ant-...
UPSTREAM_URL=https://api.anthropic.com

# Klucze dla programistow: "klucz:nazwa,klucz2:nazwa2". Puste = przekazuj klucz klienta dalej (passthrough)
GATEWAY_KEYS=dev-alice-123:alice,dev-bob-456:bob

# enforce = blokuj naruszenia, monitor = tylko loguj
GATEWAY_MODE=enforce
# Dzienny limit tokenow (input+output) na klienta, 0 = brak
DAILY_TOKEN_LIMIT=500000
# Maks. tokenow wejsciowych w jednym zapytaniu, 0 = brak
MAX_INPUT_TOKENS=100000
# 1 = dokladne liczenie przez /v1/messages/count_tokens Anthropica, 0 = heurystyka lokalna
EXACT_TOKEN_COUNT=0
AUDIT_LOG=audit.jsonl
